generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                Int           @id @default(autoincrement())
  nome              String
  email             String        @unique
  cpf               String?       @unique
  fotoPerfilUrl     String?
  telefone          String?
  senha             String?
  bloqueado         Boolean       @default(false)
  suspensoAte       DateTime?
  googleId          String?       @unique
  resetToken        String?       @unique
  resetTokenExpiry  DateTime?
  createdAt         DateTime      @default(now())
  agendamentos      Agendamento[]
  avaliacoes        Avaliacao[]
  denuncias         Denuncia[]
  favoritos         Favorito[]
  enderecos         EnderecoUsuario[]
}

model EnderecoUsuario {
  id          Int      @id @default(autoincrement())
  usuarioId    Int
  nome        String
  cep         String?
  logradouro  String
  numero      String
  complemento String?
  bairro      String
  cidade      String
  uf          String
  referencia  String?
  principal   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

model Dono {
  id               Int      @id @default(autoincrement())
  nome             String
  login            String   @unique
  email            String?  @unique
  cnpj             String?
  senha            String?
  bloqueado        Boolean  @default(false)
  suspensoAte      DateTime?
  googleId         String?  @unique
  resetToken       String?  @unique
  resetTokenExpiry DateTime?
  createdAt        DateTime @default(now())
  lojas            Loja[]
}

model Loja {
  id           Int           @id @default(autoincrement())
  nome         String
  descricao    String
  endereco     String
  latitude     Float
  longitude    Float
  precoMedio   Float         @default(0)
  categoria    String        @default("serviços gerais")
  fotoUrl      String
  capaUrl      String?
  fotosAdicionais String?
  formasPagamento String @default("Pix, Cartão, Dinheiro")
  politicaCancelamento String @default("Cancelamentos e reagendamentos podem ser feitos até 2 horas antes do horário marcado.")
  agendaDias   String        @default("1,2,3,4,5,6")
  agendaHorarios String      @default("08:00,09:30,11:00,13:30,15:00,16:30")
  bloqueado    Boolean       @default(false)
  inativoAte   DateTime?
  statusAprovacao String     @default("aprovada")
  healthStatus String       @default("healthy") @map("health_status")
  healthReasons String[]    @default([]) @map("health_reasons")
  donoId       Int
  dono         Dono          @relation(fields: [donoId], references: [id])
  servicos     ServicoLoja[]
  agendamentos Agendamento[]
  avaliacoes   Avaliacao[]
  denuncias    Denuncia[]
  notificacoes Notificacao[]
  favoritos    Favorito[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([inativoAte])
}

model ServicoLoja {
  id           Int           @id @default(autoincrement())
  nome         String
  descricao    String
  preco        Float
  duracao      String
  inclusos     String?
  etapas       String?
  produtos     String?
  orientacoes  String?
  garantia     String?
  lojaId       Int
  loja         Loja          @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  agendamentos Agendamento[]
  createdAt    DateTime      @default(now())
}

model Agendamento {
  id           Int          @id @default(autoincrement())
  data         String
  hora         String
  veiculo      String       @default("Carro")
  notas        String?
  status       String       @default("pendente")
  nomeCliente  String?
  emailCliente String?
  valorServico Float?
  codigoRetirada String?    @unique
  usuarioId    Int?
  lojaId       Int
  servicoId    Int
  usuario      Usuario?     @relation(fields: [usuarioId], references: [id])
  loja         Loja         @relation(fields: [lojaId], references: [id])
  servico      ServicoLoja  @relation(fields: [servicoId], references: [id])
  avaliacao    Avaliacao?
  denuncias    Denuncia[]
  createdAt    DateTime     @default(now())
}

model Avaliacao {
  id            Int          @id @default(autoincrement())
  nota          Int
  comentario    String?
  fotoUrl       String?
  nomeCliente   String?
  aprovado      Boolean      @default(true)
  bloqueado     Boolean      @default(false)
  usuarioId     Int?
  lojaId        Int
  agendamentoId Int?         @unique
  usuario       Usuario?     @relation(fields: [usuarioId], references: [id])
  loja          Loja         @relation(fields: [lojaId], references: [id])
  agendamento   Agendamento? @relation(fields: [agendamentoId], references: [id])
  denuncias     Denuncia[]
  createdAt     DateTime     @default(now())
}

model Denuncia {
  id              Int          @id @default(autoincrement())
  tipo            String
  motivo          String?
  detalhes        String?
  status          String       @default("aberta")
  anonima         Boolean      @default(false)
  respostaLoja    String?
  anexosResposta  String?
  dataResposta    DateTime?
  parecerAdmin    String?
  usuarioId       Int?
  lojaId          Int?
  avaliacaoId     Int?
  agendamentoId   Int?
  usuario         Usuario?     @relation(fields: [usuarioId], references: [id])
  loja            Loja?        @relation(fields: [lojaId], references: [id])
  avaliacao       Avaliacao?   @relation(fields: [avaliacaoId], references: [id])
  agendamento     Agendamento? @relation(fields: [agendamentoId], references: [id])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Notificacao {
  id        Int      @id @default(autoincrement())
  lojaId    Int      @map("loja_id")
  titulo    String
  mensagem  String
  tipo      String
  lida      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  loja      Loja     @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  @@index([lojaId, lida, createdAt])
  @@map("Notificacao")
}

model Favorito {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  lojaId    Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  loja      Loja     @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([usuarioId, lojaId])
}
